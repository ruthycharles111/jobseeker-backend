# Required Litestream / IDrive e2 configuration
LITESTREAM_ACCESS_KEY_ID=replace-with-idrive-access-key
LITESTREAM_SECRET_ACCESS_KEY=replace-with-idrive-secret-key
LITESTREAM_S3_ENDPOINT=s3.us-midwest-1.idrivee2.com
LITESTREAM_S3_BUCKET=replace-with-bucket-name

# Required application credentials
PB_ADMIN_TOKEN=replace-with-pocketbase-admin-token
MISTRAL_API_KEY=replace-with-mistral-api-key

# Set automatically by run.sh in the container
POCKETBASE_URL=http://localhost:8090

# Optional job-search provider credentials
SERPAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FINDWORK_KEY=
RAPIDAPI_KEY=
